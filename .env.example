# ============================================================
# Six-Channel Clinical Assistant - Environment Template V1.1
# 只保留变量名和占位符，不得提交真实密钥。
# 本地 Codex Python 调试环境固定使用 Conda: langgraph。
# ============================================================

APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- LLM ----------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
CLINICAL_PARSER_MODE=rules
# rules: 确定性工程基线；llm: 八纲/六经候选使用结构化模型，失败明确报错
REASONING_MODE=rules
# extractive: 分层来源摘录；llm: 模型分类/选择已核验摘录，正文始终由来源构建
KNOWLEDGE_QA_MODE=extractive

# ---------- Embedding ----------
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Pro/BAAI/bge-m3
# 服务未公开修订号时，此标签表示接入快照；供应商模型升级需更改标签并重新索引。
EMBEDDING_MODEL_VERSION=siliconflow-bge-m3-2026-10-07
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

# ---------- Reranker ----------
RERANKER_PROVIDER=siliconflow
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=30
RERANKER_MAX_RETRIES=2

# ---------- Milvus: Remote first, Lite fallback ----------
# auto: 先尝试 Docker/Remote Milvus；失败时若允许则切 Milvus Lite
# remote: 只使用 Remote，失败直接报错
# lite: 直接使用 Milvus Lite
MILVUS_MODE=lite
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_LITE_PATH=./data/milvus_lite.db
MILVUS_FALLBACK_TO_LITE=true
# 实际使用 Lite（含 auto 降级）且 dense/hybrid 索引缺失时，启动自动建索引。
# 使用配置的 Embedding 服务，首次启动会等待向量化；已有完整索引直接复用。
MILVUS_LITE_AUTO_INDEX=true
MILVUS_CONNECT_TIMEOUT_SECONDS=3
MILVUS_OPERATION_TIMEOUT_SECONDS=30
MILVUS_COLLECTION_CLASSIC=six_channel_classic_v12
MILVUS_COLLECTION_FORMULA=six_channel_formula_v12
MILVUS_COLLECTION_DIFFERENTIAL=six_channel_differential_v12
MILVUS_COLLECTION_CASE=six_channel_case_v12
MILVUS_COLLECTION_FRAMEWORK=six_channel_framework_v12
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64

# ---------- PostgreSQL business database ----------
# 本地未接入业务 PostgreSQL 时可设 false；不要把 AsyncSqliteSaver 当 ORM 数据库。
DATABASE_ENABLED=false
# disabled 关闭会诊；memory 为显式开发验证（服务重启丢失）；postgres 需迁移与真实连接。
# S5 持久任务仅 postgres 支持进程重启恢复；SQLite 只保存图状态。
RUN_LEASE_SECONDS=30
RUN_POLL_SECONDS=1
RUN_TIMEOUT_SECONDS=300
RUN_MAX_ATTEMPTS=3
RUN_MAX_CONCURRENT=4
CONSULTATION_STORAGE=memory
CONSULTATION_RUN_MODE=async
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800

# ---------- LangGraph Checkpoint: PostgreSQL first, SQLite fallback ----------
# auto: 有可用 PostgreSQL 则用 PostgreSQL，否则 AsyncSqliteSaver
# postgres: 只使用 PostgreSQL
# sqlite: 直接使用 AsyncSqliteSaver
CHECKPOINT_BACKEND=sqlite
LANGGRAPH_DATABASE_URL=
LANGGRAPH_SQLITE_PATH=./data/langgraph_checkpoints.sqlite3
CHECKPOINT_FALLBACK_TO_SQLITE=true
POSTGRES_CONNECT_TIMEOUT_SECONDS=3

# ---------- RAG / Reasoning ----------
# hybrid/dense 在 Lite 下自动补建缺失索引；Remote 仍需预建，模型失败不静默降级。
RETRIEVAL_MODE=bm25
RERANKER_ENABLED=false
FUSION_RRF_CONSTANT=60
KNOWLEDGE_BASE_VERSION=1.2
PROTOCOL_VERSION=1.0
SCORING_CONFIG_VERSION=1.0
# RP-13 工程默认值；完整 JSON 可覆盖，正向权重总和必须为 1，高反证惩罚高于 core。
SCORING_POLICY={"core":0.25,"differential":0.25,"classic":0.20,"formula":0.10,"temporal":0.10,"case":0.05,"context":0.05,"high_penalty":0.35,"medium_penalty":0.15,"high_threshold":0.8}
TOP_K_DEFAULT=3
TOPK_CHANNEL_WEIGHT=0.6
# TOPK_CHANNEL_WEIGHT 为旧聚合兼容配置；当前路径排序使用 SCORING_POLICY。
TOP_K_MAX=5
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8
MAX_SUPPLEMENT_ROUNDS=3
# RP-11 工程提问排序及停止阈值，不代表诊断概率；需要后续专家校准。
EVIDENCE_GAP_POLICY={"separation_threshold":0.15,"high_weight_threshold":0.8,"minimum_priority":0.1,"answerability":1.0,"reviewed_source_reliability":0.8,"unreviewed_source_reliability":0.4,"repetition_penalty":0.1,"question_cost":0.05}

# ---------- SSE ----------
SSE_HEARTBEAT_SECONDS=15

# ---------- Observability ----------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=six-channel-clinical-assistant

# Docker Compose 本地基础设施凭据，必须由开发者填写。
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 相对仓库根目录；未配置时依据工程位置定位。
KNOWLEDGE_DIRECTORY=./knowledge/v1.2
